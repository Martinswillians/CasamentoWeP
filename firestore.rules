rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada usuário: só o próprio dono lê e edita
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Dados do casamento (compartilhados entre Willians, Poliana e quem tiver conta)
    match /wedding/{doc} {
      allow read, write: if request.auth != null;
      // Para restringir só a pessoas específicas, troque a linha acima por:
      // allow read, write: if request.auth != null
      //   && request.auth.token.email in ['email1@gmail.com', 'email2@gmail.com'];
    }

    // Respostas do convite (página pública convite.html)
    // Convidados (sem login) só podem CRIAR uma resposta válida.
    // Só quem tem login no app pode ler ou apagar.
    match /rsvps/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['nome','status','acompanhantes','restricao','mensagem','createdAt'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 3
                    && request.resource.data.nome.size() <= 80
                    && request.resource.data.status in ['Confirmado','Recusou']
                    && request.resource.data.acompanhantes is int
                    && request.resource.data.acompanhantes >= 0
                    && request.resource.data.acompanhantes <= 10
                    && request.resource.data.restricao is string
                    && request.resource.data.restricao.size() <= 200
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }
  }
}
