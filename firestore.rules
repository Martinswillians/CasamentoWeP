rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada usuário: só o próprio dono lê e edita
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Dados do casamento (compartilhados entre Willians, Poliana e quem tiver conta)
    match /wedding/{doc} {
      allow read, write: if request.auth != null;
      // Para restringir só a pessoas específicas, troque a linha acima por:
      // allow read, write: if request.auth != null
      //   && request.auth.token.email in ['email1@gmail.com', 'email2@gmail.com'];
    }

    // Respostas do convite (página pública convite.html): uma resposta por pessoa.
    // Convidados (sem login) só podem CRIAR; só quem tem login no app lê e apaga.
    match /rsvps/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['nome','status','lado','crianca','titular','grupo','restricao','mensagem','createdAt'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 3
                    && request.resource.data.nome.size() <= 80
                    && request.resource.data.status in ['Confirmado','Recusou']
                    && request.resource.data.lado in ['noiva','noivo']
                    && request.resource.data.crianca is bool
                    && request.resource.data.titular is bool
                    && request.resource.data.grupo is string
                    && request.resource.data.grupo.size() <= 40
                    && request.resource.data.restricao is string
                    && request.resource.data.restricao.size() <= 200
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }
  }
}
